# Local persistence: SQLite file (zero external services required)
DATABASE_URL=sqlite:///./kaname.db
# Base URL the Streamlit frontend uses to reach the FastAPI backend
BACKEND_URL=http://127.0.0.1:8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
STREAMLIT_PORT=8501
GRADIO_PORT=7860
# Optional LLM translation engines (KANAME falls back to its built-in dictionary when unset)
GOOGLE_API_KEY=your-key-here
GOOGLE_MODEL=gemini-3.5-flash
